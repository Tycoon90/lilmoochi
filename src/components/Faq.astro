---
/**
 * FAQ block. Native <details> — a disclosure widget is what a question list
 * actually is, so it needs no JavaScript and is keyboard-operable for free.
 *
 * Pass the same array to faqPage() in the page's schema graph so the visible
 * answers and the FAQPage markup can never disagree.
 */
import type { Faq } from '~/lib/schema';

interface Props {
  faqs: Faq[];
  heading?: string;
}
const { faqs, heading = 'Common questions' } = Astro.props;
---

<section class="section-tight shell faq-block">
  <h2>{heading}</h2>
  <div class="faq-list">
    {
      faqs.map((f) => (
        <details>
          <summary>
            <span>{f.q}</span>
            <svg
              class="faq-chevron"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <p>{f.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq-block h2 {
    margin: 0 0 1.75rem;
  }
  .faq-list {
    border-top: 1px solid color-mix(in srgb, var(--color-nickel) 55%, transparent);
    max-width: 60rem;
  }
  details {
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-nickel) 55%, transparent);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.15rem 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.03rem;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--color-edge-deep);
  }
  .faq-chevron {
    flex: none;
    color: var(--color-edge-deep);
    transition: transform 0.2s ease;
  }
  details[open] .faq-chevron {
    transform: rotate(180deg);
  }
  details p {
    margin: 0 0 1.3rem;
    max-width: 64ch;
    color: var(--color-slate);
    line-height: 1.65;
  }
</style>
