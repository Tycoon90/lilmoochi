---
/**
 * Sticky click-to-call bar, mobile only.
 *
 * Phone is how most of these leads actually arrive, so the number is
 * permanently reachable with a thumb rather than buried on the contact page.
 * Hidden at the desktop breakpoint, where the header already shows it.
 */
import { business } from '~/data/business';
---

<div class="callbar">
  <a
    class="callbar__call"
    href={`tel:${business.phoneRaw}`}
    data-track="phone_click_sticky"
  >
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"
      ></path>
    </svg>
    Call {business.phone}
  </a>
  <a class="callbar__quote" href="/contact/">Get an estimate</a>
</div>

<style>
  .callbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    border-top: 1px solid color-mix(in srgb, var(--color-gold) 30%, transparent);
  }
  .callbar a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.5rem;
    font-weight: 600;
    font-size: 0.97rem;
    text-decoration: none;
  }
  .callbar__call {
    background: var(--color-gold);
    color: var(--color-ink);
  }
  .callbar__quote {
    background: var(--color-ink);
    color: #fff;
  }
  @media (min-width: 768px) {
    .callbar {
      display: none;
    }
  }
  @media print {
    .callbar {
      display: none;
    }
  }
</style>
