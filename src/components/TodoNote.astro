---
/**
 * A visible, deliberately un-missable placeholder for a value only the client
 * can supply — prices, above all.
 *
 * Nothing here is invented. Every instance is listed in the README, and every
 * one must be resolved or removed before launch. Search the codebase for
 * "TodoNote" to find them all.
 */
interface Props {
  /** What the client needs to confirm. */
  label: string;
}
const { label } = Astro.props;
---

<p class="todo" role="note">
  <strong>TODO: confirm with client</strong>
  <span>{label}</span>
</p>

<style>
  /* Deliberately off-brand. Gold is now the company's own colour, so a warning
     drawn in gold reads as decoration; this has to read as unfinished work.
     Dashed border, alert red, and it stays that way until the client supplies
     the figure and the block is deleted. */
  .todo {
    max-width: 60ch;
    margin: 1.75rem 0;
    padding: 1rem 1.2rem;
    background: #fff;
    border: 2px dashed #8c1d18;
    color: var(--color-ink);
    font-size: 0.93rem;
    line-height: 1.55;
  }
  .todo strong {
    display: block;
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8c1d18;
    margin-bottom: 0.35rem;
  }
</style>
