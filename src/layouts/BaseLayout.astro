---
/**
 * BaseLayout — every page renders through here.
 *
 * Owns the four things the previous site was missing entirely: a unique
 * keyword-bearing title, a meta description, canonical/OG/Twitter tags, and
 * JSON-LD structured data. `title` and `description` are required props, so a
 * page cannot be published without them.
 */
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import CallBar from '~/components/CallBar.astro';
import { business, SITE } from '~/data/business';
import { graph, localBusiness, breadcrumbs, type Crumb } from '~/lib/schema';

interface Props {
  /** Under 60 characters. Names the service and, where natural, the city. */
  title: string;
  /** Under 155 characters. */
  description: string;
  /** Additional JSON-LD nodes (Service, FAQPage, ImageObject…). */
  schema?: object[];
  /** Breadcrumb trail, excluding Home, which is prepended automatically. */
  crumbs?: Crumb[];
  /** Social share image under /images/. */
  ogImage?: string;
  /** Keep a page out of the index (used by /thank-you/ and /404/). */
  noindex?: boolean;
  /** Suppress the page-level H1 wrapper padding for full-bleed heroes. */
  bodyClass?: string;
}

const {
  title,
  description,
  schema = [],
  crumbs = [],
  ogImage = '/images/og-default.jpg',
  noindex = false,
  bodyClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).href;
const ogUrl = new URL(ogImage, SITE).href;

const trail: Crumb[] = [{ name: 'Home', url: '/' }, ...crumbs];
const nodes = [
  localBusiness(),
  ...(trail.length > 1 ? [breadcrumbs(trail)] : []),
  ...schema,
];

// Analytics identifiers come from the environment, never from source.
// See README for the exact variables to set in Netlify.
const GA4_ID = import.meta.env.PUBLIC_GA4_ID;
const GSC_TOKEN = import.meta.env.PUBLIC_GSC_VERIFICATION;

// Serialised once. `<` is escaped so a stray "</script>" in any string value
// cannot break out of the tag.
const jsonLd = JSON.stringify(graph(nodes)).replace(/</g, '\\u003c');

if (title.length > 60) {
  console.warn(`[seo] title over 60 chars (${title.length}): ${title}`);
}
if (description.length > 155) {
  console.warn(
    `[seo] description over 155 chars (${description.length}): ${canonical}`,
  );
}
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {GSC_TOKEN && <meta name="google-site-verification" content={GSC_TOKEN} />}

    <!-- The display face is the LCP text; preload it so the hero never reflows. -->
    <link
      rel="preload"
      href="/fonts/archivo-expanded.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/plex-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <meta name="theme-color" content="#101e1c" />
    <link rel="icon" href="/images/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/images/favicon-512.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <script is:inline type="application/ld+json" set:html={jsonLd} />

    {
      GA4_ID && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}
          />
          <script is:inline define:vars={{ GA4_ID }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', GA4_ID);
            // Every phone link and form submit carries data-track; forward them
            // as GA4 events without hardcoding a measurement ID anywhere.
            document.addEventListener('click', (e) => {
              const el = e.target.closest('[data-track]');
              if (el) gtag('event', el.dataset.track, { link_url: el.href });
            });
          </script>
        </>
      )
    }
  </head>

  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CallBar />
    <style is:global>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--color-ink);
        color: #fff;
        padding: 0.85rem 1.25rem;
        text-decoration: none;
        font-weight: 600;
      }
      .skip-link:focus {
        left: 0.5rem;
        top: 0.5rem;
      }
      /* Room for the sticky call bar on small screens. */
      @media (max-width: 767px) {
        body {
          padding-bottom: 4.25rem;
        }
      }
    </style>
  </body>
</html>
