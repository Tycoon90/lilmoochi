# Analytics and verification. Set these in the Netlify (or Vercel) dashboard —
# no measurement ID is ever hardcoded in source. Both are optional: the site
# builds and runs without them, simply emitting no analytics.

# GA4 measurement ID, e.g. G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google Search Console HTML-tag verification token (the content value only,
# not the whole <meta> tag)
PUBLIC_GSC_VERIFICATION=
